{
  // Debug Python do Odoo (debugpy). Arranca em debug com `make debug` → depois F5 aqui.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Odoo",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "justMyCode": false,
      "pathMappings": [
        { "localRoot": "${workspaceFolder}/addons", "remoteRoot": "/mnt/extra-addons" }
      ]
    }
  ]
}
