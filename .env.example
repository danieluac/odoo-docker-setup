# ═══════════════════════════════════════════════════════════════════════
# .env — a ÚNICA fonte de configuração do ambiente (make + docker compose)
#
# Este ficheiro é criado automaticamente a partir do .env.example na
# primeira execução de qualquer comando `make`. Nunca é regenerado nem
# sobrescrito — edita à vontade e volta a correr `make up`.
# ═══════════════════════════════════════════════════════════════════════

# Versão do Odoo (imagem oficial: 16.0, 17.0, 18.0, …).
# Mudar a versão cria um ambiente NOVO e isolado (containers, volumes e
# bases de dados separados) — os dados da versão anterior não se perdem.
ODOO_VERSION=16.0

# Versão do Postgres (imagem pgvector/pgvector:pg<versão> = postgres + extensão vector)
# ⚠ não mudar depois de já teres dados — o Postgres não lê dados de outra versão
POSTGRES_VERSION=15

# Só para o Odoo 16 (o default aqui): o Debian 11 da imagem odoo:16 saiu de suporte em
# 2026-08, por isso o apt é fixado num snapshot datado (snapshot.debian.org).
# Normalmente não precisas de mexer; se o snapshot falhar, experimenta outra data.
#DEBIAN_SNAPSHOT=20260901T000000Z

# Porta HTTP no host → http://localhost:<ODOO_PORT>
# ⚠ Se correres mais do que um ambiente nesta máquina (outro clone deste repo),
#   cada um precisa da sua porta — e de INSTANCE diferente se for a mesma versão.
ODOO_PORT=8069

# Identificador do ambiente (opcional). O nome do projecto Docker é
# odoo-<versão>[-<INSTANCE>]: sem INSTANCE, dois clones com a mesma versão
# partilham o MESMO projecto e o `make up` de um recria (mata) os containers
# do outro. Ex.: INSTANCE=cliente-a (minúsculas, dígitos, - e _).
INSTANCE=

# Base de dados activa — o servidor arranca amarrado a ela.
# O `make restore` e o `make db-use` actualizam esta linha automaticamente.
ODOO_DB=odoo

# Credenciais do Postgres (dev — muda se o ambiente ficar exposto)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Master password do Odoo (gestor de bases de dados)
ADMIN_PASSWD=admin

# Nível de log do Odoo: debug, info, warn, error
ODOO_LOG=info

# Modos --dev do odoo-bin (reload = reinicia quando um *.py muda;
# qweb,xml = templates lidos do disco). Usa ODOO_DEV=none para desactivar.
ODOO_DEV=reload,qweb,xml

# Debug Python (debugpy) — preferir `make debug`, que liga isto por ti.
# ODOO_DEBUG=1 → o servidor arranca sob debugpy à escuta em ODOO_DEBUG_PORT
# (attach do VS Code, config "Odoo" em .vscode/launch.json).
# ODOO_WAIT=1 → espera o VS Code antes de arrancar (debugar o próprio boot).
ODOO_DEBUG_PORT=5678
#ODOO_DEBUG=1
#ODOO_WAIT=1

# Addons Odoo Enterprise (caminho no host, absoluto ou relativo ao repo).
# Vazio = modo Community (sem mount).
ENTERPRISE_DIR=

# Pasta onde os backups são gravados (relativa ao repo ou absoluta)
BACKUP_DIR=./backups

# Identidade usada pelo `make scaffold MODULE=<nome>` no manifesto dos
# módulos novos (autor, website e contribuidores — separa vários por vírgula).
MODULE_AUTHOR=A Minha Empresa
MODULE_WEBSITE=https://www.example.com
MODULE_CONTRIBUTORS=

# Postgres afinado para DEV (fsync off → restores e testes muito mais
# rápidos, MAS sem durabilidade em crash). PG_TUNING=0 desliga.
# ⚠ NUNCA usar este tuning em produção.
PG_TUNING=1
