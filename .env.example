# ═══════════════════════════════════════════════════════════════════════
# .env — a ÚNICA fonte de configuração do ambiente (make + docker compose)
#
# Este ficheiro é criado automaticamente a partir do .env.example na
# primeira execução de qualquer comando `make`. Nunca é regenerado nem
# sobrescrito — edita à vontade e volta a correr `make up`.
# ═══════════════════════════════════════════════════════════════════════

# ── Versões ─────────────────────────────────────────────────────────────

# Versão do Odoo (16.0, 17.0, 18.0, 19.0, 20.0). Por omissão, a desta branch.
# Mudar a versão cria um ambiente NOVO e isolado (containers, volumes e
# bases de dados separados) — os dados da versão anterior não se perdem.
ODOO_VERSION=17.0

# Versão do PostgreSQL (imagem pgvector/pgvector:pg<versão> = PostgreSQL + extensão vector).
# O valor por omissão cumpre o mínimo exigido por esta versão do Odoo.
# ⚠ não mudar depois de já teres dados — o PostgreSQL não lê dados de outra versão
POSTGRES_VERSION=15

# Só Odoo 16: a imagem assenta em Debian 11, cujos pacotes vêm do arquivo
# histórico do Debian (snapshot datado). Normalmente não precisas de mexer;
# para usar outra data, descomenta e ajusta.
#DEBIAN_SNAPSHOT=20260901T000000Z

# ── Portas (o que fica acessível na tua máquina) ────────────────────────

# Interface web do Odoo → http://localhost:<ODOO_PORT>
ODOO_PORT=8069

# Depurador Python (debugpy). Só é publicada pelo `make debug`.
ODOO_DEBUG_PORT=5678

# PostgreSQL acessível a partir do host (DBeaver, pgAdmin, psql local…).
# Vazio = não publicado (o Odoo usa a rede interna do Docker; tu usas make psql).
# Ex.: POSTGRES_PORT=5432
POSTGRES_PORT=

# ── Identidade do ambiente ──────────────────────────────────────────────

# Nome do projecto Docker = odoo-<versão>[-<INSTANCE>].
# Define INSTANCE quando tiveres mais do que um clone deste repo com a MESMA
# versão a correr na mesma máquina (cada um com a sua ODOO_PORT).
# Ex.: INSTANCE=cliente-a (minúsculas, dígitos, - e _).
INSTANCE=

# Base de dados activa — o servidor arranca amarrado a ela.
# O `make restore` e o `make db-use` actualizam esta linha automaticamente.
ODOO_DB=odoo

# ── Credenciais (desenvolvimento — muda se o ambiente ficar exposto) ────

POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Master password do Odoo (gestor de bases de dados)
ADMIN_PASSWD=admin

# ── Comportamento do servidor ───────────────────────────────────────────

# Nível de log do Odoo: debug, info, warn, error
ODOO_LOG=info

# Modos --dev do odoo-bin (reload = reinicia quando um *.py muda;
# qweb,xml = templates lidos do disco). Usa ODOO_DEV=none para desactivar.
ODOO_DEV=reload,qweb,xml

# Debug Python permanente (preferir `make debug`, que liga isto por ti).
# ODOO_DEBUG=1 → o servidor arranca sob debugpy à escuta em ODOO_DEBUG_PORT
# (attach do VS Code, config "Odoo" em .vscode/launch.json).
# ODOO_WAIT=1 → espera o VS Code antes de arrancar (depurar o próprio boot).
#ODOO_DEBUG=1
#ODOO_WAIT=1

# Addons Odoo Enterprise DA MESMA VERSÃO (caminho no host, absoluto ou
# relativo ao repo). Vazio = modo Community (sem mount).
ENTERPRISE_DIR=

# Pastas de addons FORA deste setup (outros repos de módulos), separadas por
# vírgula; absolutas, ~/… ou relativas à raiz do repo. Entram no addons_path
# por esta ordem, a seguir a addons/ e repos/. Vazio = nenhuma.
# (Alternativa sem configuração: clona os repos para a pasta repos/ — é
#  ignorada pelo git e as pastas de módulos lá dentro são descobertas sozinhas.)
# Ex.: ADDONS_PATHS=../seguros/addons/extra-addons/seguros,../odoo_global/addons/custom-addons
ADDONS_PATHS=

# Pacotes a NÃO instalar dos requirements.txt dos repos de módulos (separados
# por vírgula), além dos pacotes de sistema Ubuntu/Debian já ignorados por
# omissão (apturl, python-apt, command-not-found…). Útil quando um
# requirements.txt foi feito com `pip freeze` e traz coisas que não existem
# no PyPI. O que mesmo assim não resolver é ignorado no build e listado no fim.
ADDONS_REQUIREMENTS_IGNORE=

# PostgreSQL afinado para DESENVOLVIMENTO (fsync off → restores e testes
# muito mais rápidos, MAS sem durabilidade em crash). PG_TUNING=0 desliga.
# ⚠ NUNCA usar este tuning em produção.
PG_TUNING=1

# ── Ficheiros ───────────────────────────────────────────────────────────

# Pasta onde os backups são gravados (relativa ao repo ou absoluta)
BACKUP_DIR=./backups

# Identidade usada pelo `make scaffold MODULE=<nome>` no manifesto dos
# módulos novos (autor, website e contribuidores — separa vários por vírgula).
MODULE_AUTHOR=A Minha Empresa
MODULE_WEBSITE=https://www.example.com
MODULE_CONTRIBUTORS=
